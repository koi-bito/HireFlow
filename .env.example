# Gemini API Credentials
GOOGLE_API_KEY=your_gemini_api_key_here
GOOGLE_GENAI_USE_VERTEXAI=FALSE
MODEL_NAME=gemini-3.5-flash

# Matcher Configuration: keyword | embedding | hybrid
MATCHER_MODE=hybrid

# Embedding Configuration
EMBEDDING_MODEL=models/gemini-embedding-001
LOCAL_FALLBACK_EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_CACHE_DIR=.cache/embeddings

# Retrieval & Ranking Parameters
RETRIEVAL_TOP_K=10
RERANK_TOP_N=5

# Weights & Boosts
WEIGHT_RETRIEVAL=0.4
WEIGHT_LLM=0.6
EXPERIENCE_BOOST_WEIGHT=0.05
LOCATION_BOOST_WEIGHT=0.05
RRF_K=60

# Database Persistence
DB_PATH=hireflow.db

# Outreach limits
OUTREACH_MAX_CANDIDATES=5

# Security / CORS (comma-separated list, or * for dev)
CORS_ORIGINS=*
